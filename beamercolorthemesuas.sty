\RequirePackage{color}
% Gemini theme
% https://github.com/anishathalye/gemini

% ====================
% Definitions
% ====================

% Colors from https://www.cam.ac.uk/brand-resources/guidelines/typography-and-colour/rgb-and-hex-references
\definecolor{itdviolett}{RGB}{185, 164, 198}
\definecolor{suasblack}{RGB}{50, 50, 50}

% Extra colors
\definecolor{lightgray}{RGB}{240, 240, 240}
\definecolor{lightorange}{RGB}{255, 245, 242}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=suasblack,bg=white}
\setbeamercolor{palette secondary}{fg=suasblack,bg=white}
\setbeamercolor{palette tertiary}{bg=suasblack,fg=white}
\setbeamercolor{palette quaternary}{fg=suasblack,bg=white}
\setbeamercolor{structure}{fg=itdviolett}

% Headline
\setbeamercolor{headline}{fg=suasblack,bg=itdviolett}

% Block
\setbeamercolor{block title}{fg=suasblack,bg=white}
\setbeamercolor{block separator}{bg=suasblack}
\setbeamercolor{block body}{fg=suasblack,bg=white}

% Alert Block
\setbeamercolor{block alerted title}{fg=suasblack,bg=itdviolett!60}
\setbeamercolor{block alerted separator}{bg=suasblack}
\setbeamercolor{block alerted body}{fg=suasblack,bg=itdviolett!20}

% Example Block
\setbeamercolor{block example title}{fg=suasblack,bg=gray!60}
\setbeamercolor{block example separator}{bg=suasblack}
\setbeamercolor{block example body}{fg=suasblack,bg=lightgray}

% Heading
\setbeamercolor{heading}{fg=black}

% Itemize
\setbeamercolor{item}{fg=itdviolett}

% Bibliography
\setbeamercolor{bibliography item}{fg=suasblack}
\setbeamercolor{bibliography entry author}{fg=suasblack}
\setbeamercolor{bibliography entry title}{fg=suasblack}
\setbeamercolor{bibliography entry location}{fg=suasblack}
\setbeamercolor{bibliography entry note}{fg=suasblack}
